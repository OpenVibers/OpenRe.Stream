+function start() {
+    if (timer || !client.enabled()) return;
+    timer = setInterval(() => { reconcileOnce().catch(err => console.warn('[OpenRe] reconcile failed:', err.message)); }, RECONCILE_MS);
+    if (timer.unref) timer.unref();
+}
