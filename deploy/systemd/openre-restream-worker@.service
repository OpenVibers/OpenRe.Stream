[Unit]
Description=OpenRe.Stream restream worker (ffmpeg per destination), release %i
# One instance per release (instance name = the release directory). A worker deploy STARTS a new
# instance; the coordinator gives it every new output and drains the older generation, whose
# outputs run until their sessions end (or OPENRE_DRAIN_MAX_MS: then they move over) before it exits 0.
# Nothing here depends on openre-api or openre-session-coordinator: an API deploy never restarts
# this unit. Never `systemctl restart` it during a broadcast; see README "Deploying".
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openre.stream/releases/%i
EnvironmentFile=/etc/openvibe/openre.env
Environment=NODE_ENV=production
Environment=OPENRE_RELEASE=%i
Environment=OPENRE_DB_PATH=/var/lib/openre/openre.db
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node workers/restream-worker.js
# A crash restarts the instance as a new generation; a clean exit (drained) stays stopped.
Restart=on-failure
RestartSec=2
# SIGTERM starts a drain. KillMode=mixed: the ffmpeg children never get it from systemd directly.
KillSignal=SIGTERM
KillMode=mixed
# An explicit stop (or host shutdown) waits this long for outputs to end, then kills.
TimeoutStopSec=30min
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openre

[Install]
WantedBy=multi-user.target
