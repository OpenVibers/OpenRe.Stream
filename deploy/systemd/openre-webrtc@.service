[Unit]
Description=OpenRe.Stream WebRTC worker (WHIP ingest + mediasoup SFU + viewer signaling), release %i
# One instance per release (instance name = the release directory). A worker deploy STARTS a new
# instance; the coordinator then drains the older generation, which closes its public listener,
# keeps its sessions until they leave (or OPENRE_DRAIN_MAX_MS), and exits 0 by itself.
# Nothing here depends on openre-api or openre-session-coordinator: an API deploy never restarts
# this unit. Never `systemctl restart` it during a broadcast; see README "Deploying".
# Needs MEDIASOUP_ANNOUNCED_IP (the public address) and UDP 10200-10300 open (see README "Port plan").
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openre.stream/releases/%i
EnvironmentFile=/etc/openvibe/openre.env
Environment=NODE_ENV=production
Environment=OPENRE_RELEASE=%i
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node workers/webrtc.js
# A crash restarts the instance as a new generation; a clean exit (drained) stays stopped.
Restart=on-failure
RestartSec=2
# SIGTERM starts a drain; it does not drop sessions. Only the main process gets it.
KillSignal=SIGTERM
KillMode=mixed
# An explicit stop (or host shutdown) waits this long for sessions to leave, then kills.
TimeoutStopSec=30min
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openre
# mediasoup spawns its own worker subprocesses and needs the RTC UDP range.
LimitNPROC=infinity

[Install]
WantedBy=multi-user.target
