[Unit]
Description=OpenRe.Stream session coordinator: worker leases and generations, output assignment, recording requests, event relay
# Stateless between ticks (everything is in the database): restarting it never ends a session.
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openre.stream/current
EnvironmentFile=/etc/openvibe/openre.env
Environment=NODE_ENV=production
# The SQLite file the one-time move read (scripts/migrate-to-postgres.js); the store is ov_openre (ADR-035).
Environment=OPENRE_DB_PATH=/var/lib/openre/openre.db
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node workers/coordinator.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=openre
ReadWritePaths=/var/lib/openre

[Install]
WantedBy=multi-user.target
