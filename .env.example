# ═══════════════════════════════════════════════════════════════
# OpenRe.Stream — Environment Configuration
# Copy to .env for development. In production this is /etc/openvibe/openre.env (0600), read by
# every unit (openre-api, openre-session-coordinator, openre-rtmp-ingest@, openre-restream-worker@);
# the units set NODE_ENV, PORT, OPENRE_RELEASE and OPENRE_DB_PATH themselves.
# Names only here: never commit a value.
# ═══════════════════════════════════════════════════════════════

# ── openre-api ─────────────────────────────────────────────────
PORT=4500
HOST=127.0.0.1
NODE_ENV=development
#BASE_URL=https://openre.stream
# Hops in front of Node that set X-Forwarded-For (Cloudflare → nginx → Node).
#TRUST_PROXY=2
#COOKIE_SECURE=true

# ── Identity: OpenVibe.Network ────────────────────────────────
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
#OV_NETWORK_ISSUER=https://openvibe.network
# Pin the Network public key instead of fetching /api/.well-known/jwks (PEM, \n escapes allowed).
#OV_NETWORK_PUBLIC_KEY=
# OAuth client `openre`: browser sign-in for the UI (redirect https://openre.stream/auth/callback)
# and OpenRe's own client-credentials tokens (Events, Media).
OV_OAUTH_CLIENT_ID=openre
OV_OAUTH_CLIENT_SECRET=
#OV_OAUTH_REDIRECT_URI=https://openre.stream/auth/callback
# A browser's Network JWT is accepted when its aud contains one of these.
#OPENRE_USER_AUDIENCES=openvibe.openre,openvibe.network

# ── Store (SQLite, shared by every OpenRe process; WAL) ───────
OPENRE_DB_PATH=./data/openre.db

# ── Secrets ───────────────────────────────────────────────────
# 32 bytes (64 hex chars or base64): encrypts restream destination keys and SRT passphrases at rest.
# Required for destinations; generate with `openssl rand -hex 32`.
OPENRE_SECRETS_KEY=
# The previous key while rotating OPENRE_SECRETS_KEY (decryption only).
#OPENRE_SECRETS_KEY_PREVIOUS=

# ── RTMP ingest (openre-rtmp-ingest) ──────────────────────────
# Public port. Live's own ingest keeps 1935 until its RTMP is retired (README "Port plan").
OPENRE_RTMP_PORT=1936
# More public ports every worker also serves, e.g. 1935 after Live's RTMP is retired.
#OPENRE_RTMP_EXTRA_PORTS=1935
#OPENRE_RTMP_BIND=0.0.0.0
# What encoders are told: rtmp://<host>[:<port>]/live
#OPENRE_RTMP_PUBLIC_HOST=ingest.openre.stream
#OPENRE_RTMP_PUBLIC_PORT=1936
# Loopback ports each worker generation takes for its RTMP play + HTTP-FLV endpoints.
#OPENRE_RTMP_INTERNAL_PORT_MIN=19360
#OPENRE_RTMP_INTERNAL_PORT_MAX=19399
#OPENRE_RTMP_CHUNK_SIZE=60000
#OPENRE_RTMP_MAX_PUBLISHERS=64

# ── Workers, leases, drain ────────────────────────────────────
#OPENRE_WORKER_HEARTBEAT_MS=2000
# A worker silent this long is lost: its sessions fail and its outputs move to another worker.
#OPENRE_WORKER_LEASE_MS=15000
# A draining generation keeps its sessions at most this long (default 24 h), then ends them.
#OPENRE_DRAIN_MAX_MS=86400000
#OPENRE_COORDINATOR_INTERVAL_MS=1000
#OPENRE_RESTREAM_POLL_MS=1000

# ── Restream outputs (openre-restream-worker) ─────────────────
#OPENRE_FFMPEG_PATH=ffmpeg
# Static OpenSSL ffmpeg used for rtmps:// destinations (as Live's bin/ffmpeg).
#OPENRE_FFMPEG_OPENSSL_PATH=
#OPENRE_MAX_DESTINATIONS=10
# Allow destinations on loopback/private/link-local hosts (off: SSRF rule).
#OPENRE_DEST_ALLOW_PRIVATE=false
#OPENRE_OUTPUT_LOG_LIMIT=200
#OPENRE_RESTART_BASE_MS=5000
#OPENRE_RESTART_MAX_MS=120000
#OPENRE_MAX_RESTARTS=30
#OPENRE_RAPID_CRASH_MS=5000
#OPENRE_RAPID_CRASH_GIVEUP=4
#OPENRE_LIVE_ACK_TIMEOUT_MS=20000
#OPENRE_STABLE_MS=30000
#OPENRE_OUTPUT_START_DELAY_MS=3000

# ── Events (OpenVibe.Events; relay runs in the coordinator) ───
# Unset = relay off (rows still commit and wait). Grant: [openre, events.event.publish, openvibe.events].
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_PUBLISH=on
#EVENTS_RELAY_INTERVAL_MS=1000

# ── Recording requests (OpenVibe.Media) ───────────────────────
MEDIA_URL=http://127.0.0.1:4100
# The Media tenant recordings are filed under ('live' keeps them in the Live channel's gallery).
MEDIA_APP_ID=live
# 'key' = the tenant's app key below (what Media's VOD routes accept today); 'service' = a Network
# service token (needs Media to name a capability on its VOD ingest routes first).
#OPENRE_MEDIA_AUTH=key
MEDIA_API_KEY=
# OPENRE_RECORDING=off disables recording requests.
#OPENRE_RECORDING=on
#OPENRE_RECORDING_START_DELAY_MS=2000

# ── Links ─────────────────────────────────────────────────────
#OV_LIVE_URL=https://openvibe.live
